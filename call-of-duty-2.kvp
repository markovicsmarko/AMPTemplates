Meta.EndpointURIFormat=
Meta.ConfigManifest=call-of-duty-2config.json
Meta.MetaConfigManifest=call-of-duty-2metaconfig.json
Meta.ConfigRoot=call-of-duty-2.kvp
Meta.MinAMPVersion=2.8.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=RecommendedOnLinux
Meta.ContainerPolicyReason=The Windows server uses Wine and a Win32 console window. The Wine container supplies Wine, Xvfb and xauth for a headless Linux host.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=3
Meta.ReleaseNotes=Fixed Wine launch arguments, port references, configuration loading order and QuakeRCON management. Minimum version aligned with AMP 2.8.0.0. Game files are installed manually.
Meta.BreakingReleaseNotes=
Meta.AppConfigId=2ecb7452-6ec7-470b-9787-d10dc5590c55
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=Call of Duty 2
App.RootDir=./call-of-duty-2/
App.BaseDirectory=./call-of-duty-2/serverfiles/
App.StoresSupported=None
App.StoreSpecificSettings={}
App.StoreDownloadLocations={}
App.ExecutableWin=serverfiles\CoD2MP_s.exe
App.ExecutableLinux=/usr/bin/xvfb-run
App.WorkingDir=serverfiles
App.LinuxCommandLineArgs=-a /usr/bin/wine "./CoD2MP_s.exe"
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} +set dedicated 2 +exec "server.cfg" +set sv_punkbuster 0 +set net_ip {{$ApplicationIPBinding}} +set net_port {{$MainGamePort}} +set sv_maxclients {{$MaxUsers}} +set rcon_password "{{$RemoteAdminPassword}}" {{$FormattedArgs}} +map mp_leningrad
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"LD_LIBRARY_PATH":"{{$FullBaseDir}}linux64:{{$FullRootDir}}linux64:%LD_LIBRARY_PATH%","WINEPREFIX":"{{$FullRootDir}}.wine32","WINEARCH":"win32","WINEDEBUG":"-all"}
App.CommandLineParameterFormat=+set {0} "{1}"
App.CommandLineParameterDelimiter= 
App.ExitMethod=String
App.ExitMethodWindows=None
App.ExitTimeout=30
App.ExitString=quit
App.ExitFile=app_exit.lck
App.RestartDelaySeconds=0
App.HasWriteableConsole=False
App.HasReadableConsole=False
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[call-of-duty-2ports.json]
App.AdminPortRef=MainGamePort
App.PrimaryApplicationPortRef=MainGamePort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=20
App.UseRandomAdminPassword=True
App.PersistRandomPassword=True
App.RemoteAdminPassword=
App.AdminMethod=QuakeRCON
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.StripANSIControlCodes=True
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=status
App.RCONSelectIPMethod=Default
App.TelnetLoginFormat={0}
App.TelnetNewLineType=Default
App.TailLogFilePath=
App.UpdateSources=@IncludeJson[call-of-duty-2updates.json]
App.PreStartStages=[]
App.CommandTriggers={}
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=^.*CoD2MP_s\.exe.*net_port {{$MainGamePort}}(?:\s|$).*$
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.UseSteamQueryForStatus=False
App.WakeupMode=Any
App.ApplicationReadyMode=RCONConnected
App.QuiesceCommand=
App.DequiesceCommand=
App.QuiesceSettleDelayMilliseconds=5000
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=
Console.UserJoinRegex=
Console.UserLeaveRegex=
Console.UserChatRegex=
Console.UpdateAvailableRegex=
Console.PreConnectRegex=
Console.ConnectIPRegex=
Console.MetricsRegex=
Console.ServerInfoRegex=
Console.ServerAuthURLPromptRegex=
Console.ServerAuthAckRegex=
Console.ConsoleFormatRegex=
Console.DownloadProgressRegex=
Console.HideFromConsoleRegex=
Console.SuppressLogAtStart=False
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=5
Limits.SleepStartThresholdSeconds=25
